 "voice": [
  {
   "id": "a01_1",
   "sec": "plate",
   "t0": 0.9,
   "t1": 5.311,
   "dur": 4.411,
   "missing": false,
   "text": "Sosis goreng di piring sarapan. Renyah di luar, lembut di dalam."
  },
  {
   "id": "a01_2",
   "sec": "plate",
   "t0": 5.631,
   "t1": 8.299,
   "dur": 2.668,
   "missing": false,
   "text": "Tapi... dari mana SEBENARNYA sosis ini berasal?"
  },
  {
   "id": "a02_1",
   "sec": "farm",
   "t0": 9.339,
   "t1": 11.431,
   "dur": 2.092,
   "missing": false,
   "text": "Semuanya dimulai di peternakan sapi dan ayam."
  },
  {
   "id": "a02_2",
   "sec": "farm",
   "t0": 11.751,
   "t1": 16.206,
   "dur": 4.455,
   "missing": false,
   "text": "Hewan disembelih di rumah potong bersertifikat HALAL, lalu dagingnya diperiksa dokter hewan."
  },
  {
   "id": "a02_3",
   "sec": "truck",
   "t0": 16.907,
   "t1": 23.722,
   "dur": 6.815,
   "missing": false,
   "text": "Truk berpendingin membawanya, di bawah EMPAT derajat Celsius. Ikut juga tapioka, bawang putih, lada, garam, dan selongsong."
  },
  {
   "id": "a03_1",
   "sec": "gate",
   "t0": 24.407,
   "t1": 28.072,
   "dur": 3.665,
   "missing": false,
   "text": "Di gerbang pabrik, petugas mutu mengecek suhu, warna, bau, dan beratnya."
  },
  {
   "id": "a03_2",
   "sec": "gate",
   "t0": 28.392,
   "t1": 31.944,
   "dur": 3.552,
   "missing": false,
   "text": "Lolos, masuk. <short pause> Gagal, dikembalikan."
  },
  {
   "id": "a04_1",
   "sec": "grind",
   "t0": 33.611,
   "t1": 38.074,
   "dur": 4.463,
   "missing": false,
   "text": "Daging digiling halus, di mesin yang dijaga tetap DINGIN supaya lemaknya tidak meleleh."
  },
  {
   "id": "a05_1",
   "sec": "mix",
   "t0": 39.371,
   "t1": 47.87,
   "dur": 8.499,
   "missing": false,
   "text": "Lalu dicampur: daging, tapioka, bumbu, garam, dan es, sampai jadi adonan kenyal. Takarannya presisi, jadi rasanya SELALU sama."
  },
  {
   "id": "a06_1",
   "sec": "fill",
   "t0": 49.282,
   "t1": 54.421,
   "dur": 5.139,
   "missing": false,
   "text": "Bagian paling seru! Adonan didorong ke selongsong, lalu dipelintir... jadi rantai sosis!"
  },
  {
   "id": "a07_1",
   "sec": "oven",
   "t0": 55.979,
   "t1": 62.652,
   "dur": 6.673,
   "missing": false,
   "text": "Sosis dimasak di oven uap sampai bagian dalamnya TUJUH PULUH DUA derajat. Kuman tidak bisa bertahan. Sebagian juga diasap."
  },
  {
   "id": "a08_1",
   "sec": "cool",
   "t0": 64.014,
   "t1": 68.02,
   "dur": 4.006,
   "missing": false,
   "text": "Setelah matang, disiram air dingin, lalu didinginkan agar teksturnya terkunci."
  },
  {
   "id": "a09_1",
   "sec": "pack",
   "t0": 69.104,
   "t1": 75.15,
   "dur": 6.046,
   "missing": false,
   "text": "Dipotong, ditimbang, dikemas vakum, dan diberi label: tanggal, logo halal, dan izin BPOM."
  },
  {
   "id": "a09_2",
   "sec": "pack",
   "t0": 75.47,
   "t1": 78.986,
   "dur": 3.516,
   "missing": false,
   "text": "Detektor logam memastikan tidak ada benda asing. Masuk kardus, susun di palet."
  },
  {
   "id": "a10_1",
   "sec": "dist",
   "t0": 80.454,
   "t1": 87.454,
   "dur": 7.0,
   "missing": true,
   "text": "Dari gudang beku, truk berpendingin mengantarnya ke distributor, supermarket, minimarket, warung, restoran, sampai toko online!"
  },
  {
   "id": "a11_1",
   "sec": "home",
   "t0": 88.625,
   "t1": 91.825,
   "dur": 3.2,
   "missing": true,
   "text": "Dan akhirnya... kembali ke piring sarapanmu."
  },
  {
   "id": "a11_2",
   "sec": "end",
   "t0": 93.543,
   "t1": 99.143,
   "dur": 5.6,
   "missing": true,
   "text": "Dari peternakan sampai ke piring, setiap langkah dijaga: AMAN, HALAL, dan LEZAT."
  }
 ]
